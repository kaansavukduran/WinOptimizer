{
  "name": "winoptimizer-aion",
  "version": "6.5.0",
  "description": "Aion ile güvenli Windows bakım merkezi / Safe Windows care with Aion",
  "author": "Kaan Savukduran",
  "license": "GPL-3.0-only",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "python native/app.py",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "playwright test",
    "dist:win": "python scripts/build-native.py",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "8.3.7"
  },
  "build": {
    "appId": "dev.kaansavukduran.winoptimizer",
    "productName": "WinOptimizer Aion",
    "copyright": "Copyright © 2026 Kaan Savukduran and contributors",
    "asar": true,
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      }
    ],
    "directories": {
      "output": "release"
    },
    "artifactName": "WinOptimizer-Aion-${version}-Windows-${arch}-Setup.${ext}",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/assets/aion.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "WinOptimizer-Aion-${version}-Windows-${arch}-Portable.${ext}",
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "installerLanguages": [
        "tr_TR",
        "en_US"
      ],
      "language": "1055",
      "include": "scripts/installer.nsh"
    }
  }
}
